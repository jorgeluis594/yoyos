# Public variables are resolved at build time: rebuild after changing any of them.

# Absolute origin of the site, without path (canonical, hreflang, Open Graph, JSON-LD, sitemap, robots). Required.
PUBLIC_SITE_URL=https://yoyos.lat
# "true" lets search engines index every page; "false" (or empty) sends noindex and blocks crawling.
PUBLIC_INDEXING=false
# WhatsApp sales number for wa.me: digits only, country code without "+". Required.
PUBLIC_WHATSAPP_NUMBER=51977909427
# Text prefilled in the WhatsApp chat. Empty: no prefilled text.
PUBLIC_WHATSAPP_DEMO_TEXT=Hola, quiero una demo de Yoyos
# Number for the tel: link and the JSON-LD telephone, in international format. Empty: +{PUBLIC_WHATSAPP_NUMBER}.
PUBLIC_PHONE_NUMBER=+51977909427
# Phone number as shown on the page. Empty: the call number as is.
PUBLIC_PHONE_DISPLAY=+51 977 909 427
# Link of «Ingresar» to the app login. Empty: the link is hidden.
PUBLIC_APP_LOGIN_URL=https://app.yoyos.lat/login
# URL that receives the «Agenda una demo» form POST. Empty: the form, its separator and every «Agenda una demo» button are hidden.
PUBLIC_DEMO_FORM_ACTION=
# Contact email for the footer, the form notice, /privacidad and the JSON-LD. Empty: hidden.
PUBLIC_CONTACT_EMAIL=
# TikTok profile URL for the footer and the JSON-LD sameAs. Empty: hidden.
PUBLIC_TIKTOK_URL=
# Instagram profile URL for the footer and the JSON-LD sameAs. Empty: hidden.
PUBLIC_INSTAGRAM_URL=
# "true" loads the analytics listener that forwards events to window.yoyosAnalytics; "false" (or empty) loads nothing.
PUBLIC_ANALYTICS_ENABLED=false
