---
import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import AnalyticsListener from "@landing/src/components/analytics-listener.astro";
import Footer from "@landing/src/components/footer.astro";
import Header from "@landing/src/components/header.astro";
import { siteConfig } from "@landing/src/config/site";
import { brandName, skipLinkLabel } from "@landing/src/content/site";
import { serializeJsonLd, type JsonLdGraph } from "@landing/src/lib/json-ld";
import { canonicalUrl, robotsMeta, type PageSeo } from "@landing/src/lib/seo";
import "@landing/src/styles/fonts.css";
import "@landing/src/styles/global.css";
import { designTokens, themeCss } from "@landing/src/styles/design-theme";

type Props = Readonly<{
  seo: PageSeo;
  structuredData?: JsonLdGraph;
  preloadImage?: Readonly<{ href: string; type?: string; imagesrcset?: string; imagesizes?: string }>;
}>;

const { seo, structuredData, preloadImage } = Astro.props;
const { siteUrl, indexing, analyticsEnabled } = siteConfig;
const canonical = canonicalUrl(siteUrl, seo.path);
const imageUrl = `${siteUrl}${seo.image.path}`;
const isHome = seo.path === "/";
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-PE" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="robots" content={robotsMeta(indexing, seo)} />
    <meta name="theme-color" content={designTokens.colors.light.background} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={designTokens.colors.dark.background} media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={seo.socialTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(seo.image.width)} />
    <meta property="og:image:height" content={String(seo.image.height)} />
    <meta property="og:image:alt" content={seo.image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.twitterTitle} />
    <meta name="twitter:description" content={seo.twitterDescription} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={interLatinUrl} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" fetchpriority="high" {...preloadImage} />}
    <style is:global set:html={themeCss}></style>
    {structuredData && <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">{skipLinkLabel}</a>
    <Header isHome={isHome} />
    <main id="contenido">
      <slot />
    </main>
    <Footer isHome={isHome} />
    {analyticsEnabled && <AnalyticsListener />}
  </body>
</html>
