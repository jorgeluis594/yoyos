---
import { Image } from "astro:assets";
import type { PartnerLogo } from "@landing/src/content/sections/integrations";

type Props = Readonly<{ logo: PartnerLogo }>;

/** Rendered height in px (the `--control-min-height` token); no raster logo is upscaled at it (Plin 99 px, Shalom 60 px tall). */
const renderedHeight = 36;

const { logo } = Astro.props;
const width = Math.round((logo.image.width / logo.image.height) * renderedHeight);
---

<Image
  class="partner-logo"
  data-partner-logo={logo.name}
  src={logo.image}
  width={width}
  height={renderedHeight}
  alt={logo.alt}
  loading="lazy"
  decoding="async"
/>

<style>
  .partner-logo {
    height: var(--control-min-height);
    width: auto;
  }
</style>
