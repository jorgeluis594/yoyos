---
import Menu from "@lucide/astro/icons/menu";
import Phone from "@lucide/astro/icons/phone";
import X from "@lucide/astro/icons/x";
import logoLight from "@landing/src/assets/brand/yoyos-logo-light.svg";
import CtaLink from "@landing/src/components/cta-link.astro";
import { siteConfig } from "@landing/src/config/site";
import { ctaLabels, headerContent, navLinks } from "@landing/src/content/site";
import { telUrl, whatsappUrl } from "@landing/src/lib/contact";

type Props = Readonly<{ isHome: boolean }>;

const { isHome } = Astro.props;
const anchorHref = (anchor: string) => `${isHome ? "" : "/"}#${anchor}`;
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/">
      <img src={logoLight.src} width={logoLight.width} height={logoLight.height} alt={headerContent.logoAlt} />
    </a>

    <details class="menu">
      <summary>
        <Menu class="when-closed icon" aria-hidden="true" />
        <X class="when-open icon" aria-hidden="true" />
        <span class="menu-label" aria-hidden="true">{headerContent.menu.label}</span>
        <span class="visually-hidden when-closed">{headerContent.menu.open}</span>
        <span class="visually-hidden when-open">{headerContent.menu.close}</span>
      </summary>
      <div class="panel">
        <nav>
          <ul>
            {navLinks.map((link) => (
              <li><a href={anchorHref(link.anchor)}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="actions">
          <CtaLink href={whatsappUrl(siteConfig.whatsapp)} event="whatsapp_click" location="header" newTab>
            {ctaLabels.whatsapp}
          </CtaLink>
          <CtaLink
            href={telUrl(siteConfig.phone)}
            variant="secondary"
            event="call_click"
            location="header"
            ariaLabel={headerContent.callAriaLabel(siteConfig.phone.display)}
          >
            <Phone class="icon" aria-hidden="true" />
            {ctaLabels.call}
          </CtaLink>
          {siteConfig.appLoginUrl && (
            <CtaLink href={siteConfig.appLoginUrl} variant="quiet">{ctaLabels.login}</CtaLink>
          )}
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--background);
    border-block-end: var(--border-width) solid var(--border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-min-height);
  }

  .logo img {
    width: auto;
    height: var(--space-8);
  }

  .menu {
    display: contents;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target-min-size);
    padding-inline: var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--card);
    font-size: var(--text-label-size);
    font-weight: var(--text-label-weight);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .icon {
    width: var(--icon-action-size);
    height: var(--icon-action-size);
  }

  .when-open,
  details[open] .when-closed {
    display: none;
  }

  details[open] .when-open {
    display: inline-block;
  }

  details[open] .visually-hidden.when-open {
    display: block;
  }

  details:not([open]) .panel {
    display: none;
  }

  .panel {
    flex-basis: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: var(--space-4);
    padding-block-end: var(--space-4);
  }

  nav ul {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding-block: var(--space-3);
    color: var(--foreground);
    font-size: var(--text-label-size);
    font-weight: var(--text-label-weight);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--primary);
  }

  .actions {
    display: grid;
    gap: var(--space-2);
  }

  /* Desktop: the menu is always open and the summary disappears. Browsers without ::details-content keep the summary menu. */
  @media (min-width: 64em) {
    @supports selector(::details-content) {
      summary {
        display: none;
      }

      .menu {
        display: block;
        flex: 1;
      }

      .menu::details-content {
        content-visibility: visible;
        display: block;
      }

      .panel,
      details:not([open]) .panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-6);
        padding-block-end: 0;
      }

      nav ul {
        display: flex;
        gap: var(--space-6);
      }

      .actions {
        display: flex;
        align-items: center;
      }
    }
  }
</style>
