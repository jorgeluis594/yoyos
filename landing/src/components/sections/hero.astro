---
import CtaLink from "@landing/src/components/cta-link.astro";
import Screenshot from "@landing/src/components/screenshot.astro";
import { siteConfig } from "@landing/src/config/site";
import { heroContent, heroImage, heroImageSizing } from "@landing/src/content/sections/hero";
import { ctaLabels } from "@landing/src/content/site";
import { telUrl, whatsappUrl } from "@landing/src/lib/contact";

const { demoForm, phone, whatsapp } = siteConfig;
---

<section id="inicio" class="section hero">
  <div class="container layout">
    <div class="copy">
      <p class="pill-label">{heroContent.eyebrow}</p>
      <h1>{heroContent.heading}</h1>
      <p class="lead">{heroContent.lead}</p>
      <div class="actions">
        <CtaLink href={whatsappUrl(whatsapp)} event="whatsapp_click" location="hero" newTab>{ctaLabels.whatsapp}</CtaLink>
        {demoForm.kind === "enabled" && (
          <CtaLink href="#demo" variant="secondary" event="demo_form_open" location="hero">{ctaLabels.demo}</CtaLink>
        )}
      </div>
      <a class="call" href={telUrl(phone)} data-event="call_click" data-location="hero">{heroContent.callLink}</a>
      <p class="microcopy">{heroContent.microcopy}</p>
    </div>
    <div class="media">
      <Screenshot capture={heroImage} priority {...heroImageSizing} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block-start: var(--space-8);
  }

  .layout {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .copy {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .call {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min-size);
    font-weight: var(--text-label-weight);
  }

  .microcopy {
    color: var(--muted-foreground);
    font-size: var(--text-body-compact-size);
    line-height: var(--text-body-compact-line);
  }

  .media {
    padding: var(--space-4);
    border-radius: var(--radius-overlay);
    background: var(--accent);
  }

  @media (min-width: 64em) {
    .hero {
      padding-block-start: var(--space-16);
    }

    .layout {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
</style>
