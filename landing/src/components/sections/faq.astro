---
import Plus from "@lucide/astro/icons/plus";
import { faqEntries } from "@landing/src/content/faq";
import { faqContent } from "@landing/src/content/sections/faq";

const published = faqEntries.flatMap((entry) => (entry.visibility === "published" ? [entry] : []));
---

<section id="preguntas" class="faq" aria-labelledby="preguntas-titulo">
  <div class="layout">
    <h2 id="preguntas-titulo">{faqContent.heading}</h2>

    <div class="list">
      {
        published.map((entry) => (
          <details data-faq-q={entry.number}>
            <summary>
              <h3>{entry.question}</h3>
              <Plus class="icon" aria-hidden="true" />
            </summary>
            <p>{entry.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* The quiet page after the shop window and the bill: plain paper torn from the kraft above, the questions as
     ruled lines with nothing boxed, so the eye rests and reads. */
  .faq {
    position: relative;
    padding: var(--space-16) var(--page-gutter-mobile);
    background: var(--paper);
    color: var(--kraft-ink);
  }

  .faq::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 100%;
    height: var(--space-4);
    margin-block-end: calc(-1 * var(--border-width));
    background: var(--paper);
    clip-path: polygon(0 100%, 0 46%, 5% 66%, 11% 30%, 16% 58%, 23% 24%, 29% 62%, 35% 36%, 42% 68%, 48% 28%, 55% 56%, 61% 20%, 67% 62%, 74% 32%, 80% 66%, 87% 26%, 93% 58%, 98% 34%, 100% 52%, 100% 100%);
  }

  .layout {
    display: grid;
    gap: var(--space-8);
    max-width: var(--landing-max-width);
    margin-inline: auto;
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--sheet-title-size);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .list {
    border-block-start: var(--border-width) solid var(--paper-line);
  }

  details {
    border-block-end: var(--border-width) solid var(--paper-line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--touch-target-min-size);
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font-family: var(--font-display);
    font-size: var(--text-section-title-size);
    line-height: 1.3;
    font-weight: 600;
  }

  summary:hover h3 {
    color: var(--primary-hover);
  }

  .faq :focus-visible {
    outline-color: var(--kraft-ink);
  }

  .icon {
    flex: none;
    width: var(--icon-action-size);
    height: var(--icon-action-size);
    color: var(--primary);
    transition: rotate var(--motion-feedback) var(--motion-easing);
  }

  details[open] .icon {
    rotate: 45deg;
  }

  details p {
    max-width: var(--reader-max-width);
    padding-block-end: var(--space-6);
    color: var(--kraft-ink-soft);
    text-wrap: pretty;
  }

  @media (min-width: 64em) {
    .faq {
      padding: var(--space-24) var(--page-gutter-desktop);
    }

    .layout {
      grid-template-columns: auto minmax(0, var(--reader-max-width));
      justify-content: center;
      align-items: center;
      gap: var(--space-24);
    }

    h2 {
      font-size: var(--hero-price-size);
    }

    summary {
      padding-block: var(--space-6);
    }
  }
</style>
