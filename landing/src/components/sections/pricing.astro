---
import Check from "@lucide/astro/icons/check";
import CtaLink from "@landing/src/components/cta-link.astro";
import SectionHeading from "@landing/src/components/section-heading.astro";
import { siteConfig } from "@landing/src/config/site";
import { pricingContent } from "@landing/src/content/sections/pricing";
import { ctaLabels, navLinks } from "@landing/src/content/site";
import { whatsappUrl } from "@landing/src/lib/contact";

const label = navLinks.find((link) => link.anchor === "precio")?.label;
const demoEnabled = siteConfig.demoForm.kind === "enabled";
---

<section id="precio" class="section" aria-labelledby="precio-titulo">
  <div class="container">
    <SectionHeading id="precio-titulo" label={label} heading={pricingContent.heading} />

    <div class="card">
      <h3>{pricingContent.planName}</h3>
      <p class="price">
        <span class="amount">{pricingContent.price}</span>
        <span class="period">{pricingContent.period}</span>
      </p>
      <p class="vat">{pricingContent.vatNote}</p>
      <p class="lead">{pricingContent.subtext}</p>

      <p class="includes-label">{pricingContent.includesLabel}</p>
      <ul class="includes">
        {
          pricingContent.includes.map((item) => (
            <li>
              <Check class="icon" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <div class="actions">
        <CtaLink href={whatsappUrl(siteConfig.whatsapp)} event="whatsapp_click" location="precio" newTab>
          {ctaLabels.whatsapp}
        </CtaLink>
        {
          demoEnabled && (
            <CtaLink href="#demo" variant="secondary" event="demo_form_open" location="precio">
              {ctaLabels.demo}
            </CtaLink>
          )
        }
      </div>
      <p class="microcopy">{pricingContent.microcopy}</p>
    </div>
  </div>
</section>

<style>
  .card {
    display: grid;
    gap: var(--space-4);
    max-width: var(--form-max-width);
    margin: var(--space-12) auto 0;
    padding: var(--space-8);
    border: calc(2 * var(--border-width)) solid var(--primary);
    border-radius: var(--radius-overlay);
    background: var(--card);
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .amount {
    font-size: var(--text-headline-wide-size);
    line-height: var(--text-headline-wide-line);
    font-weight: var(--text-headline-weight);
  }

  .period,
  .vat,
  .microcopy {
    color: var(--muted-foreground);
  }

  .includes-label {
    font-weight: var(--text-label-weight);
  }

  .includes {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .includes li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .icon {
    width: var(--icon-inline-size);
    height: var(--icon-inline-size);
    margin-block-start: var(--space-1);
    stroke-width: var(--icon-stroke);
    color: var(--success);
  }

  .actions {
    display: grid;
    gap: var(--space-3);
  }

  .microcopy {
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-line);
  }

  @media (min-width: 48em) {
    .actions {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }
</style>
