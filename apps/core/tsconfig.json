{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@shared/*": [
        "../../shared/*"
      ]
    }
  },
  "include": [
    "app",
    "src",
    "react-router.config.ts",
    "vite.config.ts",
    "../../shared/**/*.ts"
  ]
}
