generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  companyId     String?   @db.Uuid
  company       Company?  @relation(fields: [companyId], references: [id])
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  pushDevices   PushDevice[]

  @@unique([companyId, id])

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDevice PushDevice?

  @@index([userId])
  @@map("session")
}

model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  locale    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model Company {
  nextOrderNumber BigInt @default(1001)
  catalogPublished Boolean @default(false)
  catalogSubdomain String? @unique
  id      String @id @db.Uuid
  name    String
  country String
  users   User[]
  images  Image[]
  contacts Contact[]
  chats Chat[]
  messages ChatMessage[]
  products Product[]
  productVariants ProductVariant[]
  productStocks ProductStock[]
  productOptions ProductOption[]
  productPhotos ProductPhoto[]
  productOptionValues ProductOptionValue[]
  productVariantOptionValues ProductVariantOptionValue[]
  orders Order[]
  customers Customer[]
  orderMessages OrderMessage[]
  chatMessageOutcomes ChatMessageOutcome[]
  chatPendings ChatPendings[]
  orderBuyers OrderBuyer[]
  orderItems OrderItem[]
  payments Payment[]
  deliverySettings CompanyDeliverySettings?
  paymentSettings CompanyPaymentSettings?
  dispatchSender CompanyDispatchSender?
  checkoutAppearance CompanyCheckoutAppearance?
  couriers CompanyCourier[]
  deliveryZones DeliveryZone[]
  deliveryZoneDepartments DeliveryZoneDepartment[]
  deliveryZoneProvinces DeliveryZoneProvince[]
  deliveryZoneDistricts DeliveryZoneDistrict[]
  deliveryOptions DeliveryOption[]
  deliveryOptionAgencies DeliveryOptionAgency[]
  quotations Quotation[]
  deliveryRates DeliveryRate[]
}

model DeliveryZone {
  id String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  name String @db.VarChar(120)
  enabled Boolean
  departments DeliveryZoneDepartment[]
  provinces DeliveryZoneProvince[]
  districts DeliveryZoneDistrict[]
  options DeliveryOption[]

  @@unique([companyId, id])
}

model DeliveryZoneDepartment {
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  departmentCode String @db.VarChar(2)
  zoneId String @db.Uuid
  zone DeliveryZone @relation(fields: [companyId, zoneId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([companyId, zoneId, departmentCode])
}

model DeliveryZoneProvince {
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  provinceCode String @db.VarChar(4)
  zoneId String @db.Uuid
  zone DeliveryZone @relation(fields: [companyId, zoneId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([companyId, zoneId, provinceCode])
}

model DeliveryZoneDistrict {
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  districtCode String @db.VarChar(6)
  zoneId String @db.Uuid
  zone DeliveryZone @relation(fields: [companyId, zoneId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([companyId, zoneId, districtCode])
  @@index([companyId, districtCode])
}

model Quotation {
  id String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  destination Json
  createdAt DateTime @db.Timestamptz(6)
  rates DeliveryRate[]

  @@unique([companyId, id])
}

model DeliveryRate {
  id String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  quotationId String @db.Uuid
  quotation Quotation @relation(fields: [companyId, quotationId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  method String
  optionId String @db.Uuid
  option DeliveryOption @relation(fields: [companyId, method, optionId], references: [companyId, method, id], onDelete: Restrict, onUpdate: NoAction)
  districtCode String @db.VarChar(6)
  priceAmount Decimal @db.Decimal(15, 2)
  priceCurrency String
  settingsVersion Int
  createdAt DateTime @db.Timestamptz(6)

  @@unique([companyId, id])
  @@unique([companyId, quotationId, optionId])
}

model CompanyDeliverySettings {
  companyId          String  @id @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company            Company @relation(fields: [companyId], references: [id])
  homeEnabled        Boolean @default(false)
  agencyEnabled      Boolean @default(false)
  storeEnabled       Boolean
  pickupName         String?
  pickupAddress      String?
  pickupInstructions String?
  version            Int
  couriers           CompanyCourier[]
}

model CompanyCourier {
  id        String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  settings  CompanyDeliverySettings @relation(fields: [companyId], references: [companyId], map: "CompanyCourier_settings_fkey")
  courierId String @db.Uuid
  courier   Courier @relation(fields: [courierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  enabled   Boolean

  @@unique([companyId, id])
  @@unique([companyId, courierId])
  @@index([companyId])
}

model Courier {
  id        String @id @db.Uuid
  code      String @unique @db.VarChar(40)
  name      String @db.VarChar(120)
  enabled   Boolean
  companies CompanyCourier[]
  agencies  DeliveryAgency[]
}

model DeliveryOption {
  id            String @id @db.Uuid
  companyId     String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company       Company @relation(fields: [companyId], references: [id])
  zoneId        String @db.Uuid
  zone          DeliveryZone @relation(fields: [companyId, zoneId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  method        String
  name          String @db.VarChar(120)
  enabled       Boolean
  priceAmount   Decimal @db.Decimal(15, 2)
  priceCurrency String
  agencies      DeliveryOptionAgency[]
  rates         DeliveryRate[]

  @@unique([companyId, id])
  @@unique([companyId, method, id])
  @@index([companyId, zoneId])
}

model DeliveryAgency {
  id           String @id @db.Uuid
  courierId    String @db.Uuid
  courier      Courier @relation(fields: [courierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name         String @db.VarChar(120)
  address      String @db.VarChar(500)
  districtCode String @db.VarChar(6)
  enabled      Boolean
  options      DeliveryOptionAgency[]

  @@index([courierId])
}

model DeliveryOptionAgency {
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  optionId  String @db.Uuid
  method    String @default("agency")
  option    DeliveryOption @relation(fields: [companyId, method, optionId], references: [companyId, method, id], onDelete: Restrict, onUpdate: NoAction)
  agencyId  String @db.Uuid
  agency    DeliveryAgency @relation(fields: [agencyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([companyId, optionId, agencyId])
  @@index([companyId, agencyId])
}

model CompanyPaymentSettings {
  companyId String @id @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  settings Json
}

model CompanyDispatchSender {
  companyId String   @id @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String?  @db.VarChar(120)
  phone     String?  @db.VarChar(30)
  updatedAt DateTime @updatedAt
}

enum CheckoutTheme {
  classic
  boutique
  antojo
  suave
  noche
}

model CompanyCheckoutAppearance {
  companyId   String             @id @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logoImageId String?            @db.Uuid
  logoImage   Image?             @relation(fields: [companyId, logoImageId], references: [companyId, id], onDelete: Restrict)
  theme       CheckoutTheme      @default(classic)
  updatedAt   DateTime           @updatedAt
}

enum MessageDirection {
  incoming
  outgoing
}
enum MessageSource {
  contact
  seller
}
enum MessageType {
  text
  image
}

model Image {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company            Company            @relation(fields: [companyId], references: [id])
  storageKey         String
  createdAt          DateTime           @default(now())
  messages           ChatMessage[]
  productPhotos ProductPhoto[]
  checkoutAppearances CompanyCheckoutAppearance[]
  embeddings         ImageEmbedding[]

  @@index([companyId])
  @@unique([companyId, id])
}

model Product {
  id String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  name String @db.VarChar(200)
  description String? @db.VarChar(5000)
  currency String
  qrCode String @unique
  status String
  createdAt DateTime
  updatedAt DateTime
  structureVersion Int @default(0)
  variants ProductVariant[]
  options ProductOption[]
  photos ProductPhoto[]

  @@unique([companyId, id])
  @@index([companyId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Ordered photos of a product; position 0 is the primary. Positions are contiguous by construction of the write.
model ProductPhoto {
  companyId String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  productId String  @db.Uuid
  product   Product @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Cascade)
  imageId   String  @db.Uuid
  image     Image   @relation(fields: [companyId, imageId], references: [companyId, id], onDelete: Restrict)
  position  Int

  @@id([companyId, productId, position])
  @@unique([companyId, productId, imageId])
  @@index([companyId, imageId])
}

// Embeddings belong to the image, not the product. vector has no fixed dimension: every query filters by model, so compared vectors share a length.
model ImageEmbedding {
  companyId String                @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  imageId   String                @db.Uuid
  image     Image                 @relation(fields: [companyId, imageId], references: [companyId, id], onDelete: Cascade, onUpdate: NoAction)
  model     String
  embedding Unsupported("vector")
  createdAt DateTime

  @@id([companyId, imageId, model])
}

model ProductVariant {
  id String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  productId String @db.Uuid
  product Product @relation(fields: [companyId, productId], references: [companyId, id])
  combinationKey String
  sku String? @db.VarChar(100)
  salePrice Decimal @db.Decimal(11, 2)
  purchasePrice Decimal? @db.Decimal(11, 2)
  qrCode String @unique
  status String
  stock ProductStock?
  orderItems OrderItem[]
  optionValues ProductVariantOptionValue[]

  @@unique([companyId, id])
  @@unique([companyId, productId, id])
  @@unique([companyId, productId, combinationKey])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ProductOption {
  id String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  productId String @db.Uuid
  product Product @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  name String @db.VarChar(30)
  position Int
  values ProductOptionValue[]
  variantLinks ProductVariantOptionValue[]

  @@unique([companyId, productId, id])
}

model ProductOptionValue {
  id String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  optionId String @db.Uuid
  productId String @db.Uuid
  option ProductOption @relation(fields: [companyId, productId, optionId], references: [companyId, productId, id], onDelete: Cascade)
  name String @db.VarChar(30)
  position Int
  variantLinks ProductVariantOptionValue[]

  @@unique([companyId, optionId, id])
}

model ProductVariantOptionValue {
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  productId String @db.Uuid
  variantId String @db.Uuid
  optionId String @db.Uuid
  valueId String @db.Uuid
  variant ProductVariant @relation(fields: [companyId, productId, variantId], references: [companyId, productId, id], onDelete: Cascade)
  option ProductOption @relation(fields: [companyId, productId, optionId], references: [companyId, productId, id], onDelete: Restrict)
  value ProductOptionValue @relation(fields: [companyId, optionId, valueId], references: [companyId, optionId, id], onDelete: Restrict)

  @@id([companyId, variantId, optionId])
  @@index([companyId, optionId, valueId])
}

model ProductStock {
  variantId String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  variant ProductVariant @relation(fields: [companyId, variantId], references: [companyId, id])
  quantity BigInt

  @@unique([companyId, variantId])
  @@index([companyId])
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  whatsappAccountId String @db.VarChar(128)
  whatsappLid String @db.VarChar(128)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chats     Chat[]
  orderBuyers OrderBuyer[]
  customerId String? @db.Uuid
  customer   Customer? @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([companyId, customerId])
  @@unique([companyId, id])
  @@unique([companyId, whatsappAccountId, whatsappLid])
}

model Customer {
  id        String    @id @db.Uuid
  companyId String    @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  createdAt DateTime
  contacts  Contact[]
  orders    Order[]

  @@unique([companyId, id])
}

model Chat {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  contactId String   @db.Uuid
  contact   Contact  @relation(fields: [companyId, contactId], references: [companyId, id])
  createdAt DateTime @default(now())
  messages  ChatMessage[]
  orders    Order[]
  pendings  ChatPendings?

  @@unique([companyId, id])
  @@unique([companyId, contactId])
}

model ChatMessage {
  id                  String                    @id @default(uuid()) @db.Uuid
  companyId           String                    @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company             Company                   @relation(fields: [companyId], references: [id])
  chatId              String                    @db.Uuid
  chat                Chat                      @relation(fields: [companyId, chatId], references: [companyId, id])
  externalId          String
  whatsappMessageId   String
  direction           MessageDirection
  source              MessageSource
  type                MessageType
  text                String?
  caption             String?
  sentAt              DateTime?
  receivedAt          DateTime
  imageId             String?                   @db.Uuid
  image               Image?                    @relation(fields: [companyId, imageId], references: [companyId, id])
  uploadedByUserId    String
  eventDispatchedAt   DateTime?                 @db.Timestamp(3)
  registeredBySessionId String?
  orderMessages       OrderMessage[]
  outcome             ChatMessageOutcome?

  @@unique([companyId, id])
  @@unique([companyId, chatId, whatsappMessageId])
  @@index([companyId, chatId, sentAt, id])
}

model Order {
  number BigInt
  id String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  sellerId String?
  seller User? @relation(fields: [companyId, sellerId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  fromCatalog Boolean @default(false)
  buyer OrderBuyer?
  checkoutEnabledAt DateTime?
  checkoutConfirmedAt DateTime?
  currency String
  total Decimal @db.Decimal(15, 2)
  itemsTotal Decimal @db.Decimal(15, 2)
  deliveryCost Decimal @default(0) @db.Decimal(15, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(15, 2)
  delivery Json?
  deliveryStatus String @default("pending")
  stockDeducted Boolean @default(false)
  cancelled Boolean @default(false)
  cancelledAt DateTime? @db.Timestamptz(3)
  stockDeductedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime
  scheduledDispatchDate DateTime? @db.Date
  shippedAt DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  items OrderItem[]
  payments Payment[]
  customerId String? @db.Uuid
  customer Customer? @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  chatId String? @db.Uuid
  chat Chat? @relation(fields: [companyId, chatId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  messages OrderMessage[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, chatId])
  @@index([companyId, completedAt(sort: Desc), id])
  @@index([fromCatalog, checkoutConfirmedAt, createdAt])
}

model Payment {
  id String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  orderId String @db.Uuid
  order Order @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  status String
  amount Decimal? @db.Decimal(15, 2)
  currency String
  method String?
  walletProvider String?
  deductStockIfPartial Boolean @default(false)
  data Json

  @@unique([companyId, id])
  @@index([companyId, orderId, id])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  orderId String @db.Uuid
  order Order @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [companyId, variantId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  productName String
  variantAttributes Json @db.Json
  sku String?
  quantity BigInt
  unitPrice Decimal @db.Decimal(11, 2)
  subtotal Decimal @db.Decimal(15, 2)
  mentionedPriceAmount Decimal? @db.Decimal(11, 2)
  mentionedPriceUnits Int?
  /// Units of this line already taken out of the variant's stock; never above `quantity`. The cancellation returns exactly this.
  stockDeductedQuantity BigInt @default(0)

  @@unique([companyId, orderId, variantId])
  @@index([companyId, variantId])
}

model ChatMessageOutcome {
  companyId    String      @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company      Company     @relation(fields: [companyId], references: [id])
  messageId    String      @db.Uuid
  message      ChatMessage @relation(fields: [companyId, messageId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  outcomes     Json
  noticeSentAt DateTime?   @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@id([companyId, messageId])
}

model ChatPendings {
  companyId       String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company         Company  @relation(fields: [companyId], references: [id])
  chatId          String   @db.Uuid
  chat            Chat     @relation(fields: [companyId, chatId], references: [companyId, id], onDelete: Cascade, onUpdate: NoAction)
  pendings        Json
  readyRemembered Boolean  @default(false)
  updatedAt       DateTime @db.Timestamptz(3)

  @@id([companyId, chatId])
}

model OrderMessage {
  companyId String      @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company   Company     @relation(fields: [companyId], references: [id])
  orderId   String      @db.Uuid
  order     Order       @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade, onUpdate: NoAction)
  messageId String      @db.Uuid
  message   ChatMessage @relation(fields: [companyId, messageId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime

  @@id([companyId, messageId])
  @@index([companyId, orderId])
}

model OrderBuyer {
  orderId String @id @db.Uuid
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  order Order @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade, onUpdate: NoAction)
  contactId String? @db.Uuid
  contact Contact? @relation(fields: [companyId, contactId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  name String?
  phone String?

  @@unique([companyId, orderId])
  @@index([companyId, contactId])
}
