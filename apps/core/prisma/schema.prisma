generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  companyId     String?   @db.Uuid
  company       Company?  @relation(fields: [companyId], references: [id])
  sessions      Session[]
  accounts      Account[]

  @@unique([companyId, id])

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model Company {
  id      String @id @db.Uuid
  name    String
  country String
  users   User[]
  images  Image[]
  products Product[]
  productVariants ProductVariant[]
  productStocks ProductStock[]
  contacts Contact[]
  chats Chat[]
  messages ChatMessage[]
}

enum ImageVisibility {
  public
  private
}
enum ImageImportStatus {
  pending
  ready
}
enum MessageDirection {
  incoming
  outgoing
}
enum MessageSource {
  contact
  seller
}
enum MessageType {
  text
  image
}
enum MessageImageStatus {
  pending
  processing
  ready
  failed
}
enum MessageImageFailureCode {
  MEDIA_UNAVAILABLE
  INVALID_IMAGE
  RETRIES_EXHAUSTED
}

model Image {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  company            Company            @relation(fields: [companyId], references: [id])
  storageKey         String
  visibility         ImageVisibility    @default(public)
  sourceKey          String?
  importStatus       ImageImportStatus?
  importCompletedAt  DateTime?
  createdAt          DateTime           @default(now())
  products           Product[]
  messages           ChatMessage[]

  @@unique([companyId, id])
  @@unique([companyId, sourceKey])
  @@index([companyId])
}

model Product {
  id String @id @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  name String @db.VarChar(200)
  description String? @db.VarChar(5000)
  imageId String? @db.Uuid
  image Image? @relation(fields: [companyId, imageId], references: [companyId, id])
  currency String
  qrCode String @unique
  status String
  createdAt DateTime
  updatedAt DateTime
  variants ProductVariant[]

  @@unique([companyId, id])
  @@index([companyId])
}

model ProductVariant {
  id String @id @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  productId String @db.Uuid
  product Product @relation(fields: [companyId, productId], references: [companyId, id])
  attributes Json
  sku String? @db.VarChar(100)
  salePrice Decimal @db.Decimal(11, 2)
  purchasePrice Decimal? @db.Decimal(11, 2)
  qrCode String @unique
  status String
  stock ProductStock?

  @@unique([companyId, id])
  @@index([companyId, productId])
}

model ProductStock {
  variantId String @id @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id])
  variant ProductVariant @relation(fields: [companyId, variantId], references: [companyId, id])
  quantity BigInt

  @@unique([companyId, variantId])
  @@index([companyId])
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  phone     String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chats     Chat[]

  @@unique([companyId, id])
  @@unique([companyId, phone])
}

model Chat {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  contactId String   @db.Uuid
  contact   Contact  @relation(fields: [companyId, contactId], references: [companyId, id])
  createdAt DateTime @default(now())
  messages  ChatMessage[]

  @@unique([companyId, id])
  @@unique([companyId, contactId])
}

model ChatMessage {
  id                  String                    @id @default(uuid()) @db.Uuid
  companyId           String                    @db.Uuid
  company             Company                   @relation(fields: [companyId], references: [id])
  chatId              String                    @db.Uuid
  chat                Chat                      @relation(fields: [companyId, chatId], references: [companyId, id])
  externalId          String
  direction           MessageDirection
  source              MessageSource
  userId              String?
  type                MessageType
  text                String?
  caption             String?
  sentAt              DateTime
  receivedAt          DateTime
  whatsappMediaId     String?
  imageId             String?                   @db.Uuid
  image               Image?                    @relation(fields: [companyId, imageId], references: [companyId, id])
  imageStatus         MessageImageStatus?
  imageAttempts       Int?
  imageNextAttemptAt  DateTime?
  imageClaimToken     String?
  imageLeaseUntil     DateTime?
  imageFailureCode    MessageImageFailureCode?
  imageFailureMessage String?

  @@unique([companyId, id])
  @@unique([companyId, externalId])
  @@index([companyId, chatId, sentAt, id])
  @@index([companyId, imageStatus, imageNextAttemptAt])
  @@index([companyId, imageStatus, imageLeaseUntil])
}
