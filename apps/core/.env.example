DATABASE_URL=postgresql://core_app:core_app_local@localhost:5432/core
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
LOG_LEVEL=info
# Set in production to enable New Relic APM and application log forwarding.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=yoyos-core
# Set to false if the container's stdout is also forwarded to New Relic.
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Yoyos <cuentas@yoyos.test>"
SMTP_HOST=localhost
SMTP_PORT=1025
# Required only when EMAIL_TRANSPORT=resend
RESEND_API_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_PRIVATE_BUCKET=your-private-bucket-name
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://<PUBLIC_BUCKET_URL>.r2.dev
WHATSAPP_CONNECTIONS_JSON=[]
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
