DATABASE_URL=postgresql://core_app:core_app_local@localhost:5432/core
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Brand hosts open at http://<subdomain>.localhost:3000/ (no DNS needed in Chromium, Firefox and curl).
CATALOG_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Set in production to enable New Relic APM and application log forwarding.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=yoyos-core
# Set to false if the container's stdout is also forwarded to New Relic.
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Yoyos <cuentas@yoyos.test>"
SMTP_HOST=localhost
SMTP_PORT=1025
# Required only when EMAIL_TRANSPORT=resend
RESEND_API_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://<PUBLIC_BUCKET_URL>.r2.dev
# Payment wallet QR checks run in the web process: concurrent checks per process (a busy check answers 503 at once) and the image read deadline.
PAYMENT_QR_CHECK_SLOTS=2
PAYMENT_QR_CHECK_READ_TIMEOUT_MS=10000
# Product create and editor transactions: Prisma timeout in milliseconds. lock_timeout and statement_timeout stay below it.
PRODUCT_WRITE_TRANSACTION_TIMEOUT_MS=10000
# Visual product search. The OpenAI chooser needs OPENAI_API_KEY: without it visual search stays disabled and only QR labels identify products.
OPENAI_API_KEY=
PRODUCT_MATCHER_PROVIDER=openai
PRODUCT_MATCHER_MODEL=gpt-6-luna
# local runs the image model in the worker (no key); openai describes the image with IMAGE_DESCRIBE_MODEL, then embeds the text.
# IMAGE_EMBEDDER_MODEL is the model that produces the embedding; empty uses the provider default (local:
# onnx-community/siglip2-base-patch16-224-ONNX, fetched once by pnpm models:fetch; openai: text-embedding-3-small).
# Changing provider or either model requires pnpm products:index-images.
IMAGE_EMBEDDER_PROVIDER=local
IMAGE_EMBEDDER_MODEL=onnx-community/siglip2-base-patch16-224-ONNX
IMAGE_DESCRIBE_MODEL=gpt-6-luna
PRODUCT_MATCH_CANDIDATES=5
PRODUCT_MATCH_MIN_CONFIDENCE=0.8
PRODUCT_MATCH_TIMEOUT_MS=20000
# Worker: days an unconfirmed catalog order is kept before the daily cleanup deletes it
CATALOG_ORDER_TTL_DAYS=7

# Orders from chat messages. Reading needs OPENAI_API_KEY: without it texts are skipped and captions ignored.
# Model that reads each message (Responses API) and per-call provider timeout. Every attempt also has an 85 s deadline.
AI_READER_MODEL=gpt-6-luna
AI_TIMEOUT_MS=20000
# Days a chat pending without an order is kept after its last change.
CHAT_PENDING_TTL_DAYS=7
# Most products given to the reader, items listed, and characters of a text it reads (longer texts are not read).
READER_MAX_PRODUCTS=24
READER_MAX_ITEMS=40
READER_MAX_TEXT_CHARS=2000
# Candidate search for texts: products asked from the catalog, minimum word similarity (0..1), and the pair budget that caps the searched words.
TEXT_MATCH_CANDIDATES=8
TEXT_MATCH_MIN_SIMILARITY=0.3
TEXT_MATCH_PAIR_BUDGET=25000
TEXT_MATCH_MIN_WORDS=3
TEXT_MATCH_MAX_WORDS=30
# Worker: concurrent apply-chat-message jobs, and the Prisma pool size (worker 24, web server unset = 10).
APPLY_CHAT_MESSAGE_CONCURRENCY=16
# DATABASE_POOL_MAX=24
# Seller notices: expo sends through the Expo Push Service, none disables sending. EXPO_ACCESS_TOKEN is optional.
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=
PUSH_NOTICE_TTL_SECONDS=600
# AI evals only (pnpm eval, evals/README.md): Claude judges ambiguous cases and groups failures. Never used by the app.
CLAUDE_API_KEY=
EVAL_CLAUDE_MODEL=claude-sonnet-5-5
# Hard cap on cases per run (unset = all), comma-separated case ids, runs per consistency case, 1 skips paraphrases.
EVAL_MAX_CASES=
EVAL_CASES=
EVAL_REPEATS=3
EVAL_SKIP_PARAPHRASES=0
# Photo folder with manifest.json, relative to apps/core (default evals/fixtures/images).
EVAL_IMAGES_DIR=
# Local, gitignored folder of real captures with its own manifest.json, merged at run time (default evals/fixtures/images-local).
EVAL_LOCAL_IMAGES_DIR=
