+type socketOwnerKey struct{}
+
+// socketOwnerFromContext returns the socket whose handshake created the handler
+// context, or zero for a context that did not come from a connection.
+func socketOwnerFromContext(ctx context.Context) uint64 {
+	owner, _ := ctx.Value(socketOwnerKey{}).(uint64)
+	return owner
+}
+
+// CurrentSocketID identifies the current websocket, or zero after it closes.
+func (cli *Client) CurrentSocketID() uint64 {
+	cli.socketLock.RLock()
+	defer cli.socketLock.RUnlock()
+	if cli.socket == nil || !cli.socket.IsConnected() {
+		return 0
+	}
+	return cli.socketID
+}
+
