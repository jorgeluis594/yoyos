+// TestMediaDownloadLimit covers IT-HIS-05 at the whatsmeow boundary: the bytes actually
+// received decide, a false declared length neither widens nor narrows the limit, and an
+// unlimited context keeps the dependency behavior.
+func TestMediaDownloadLimit(t *testing.T) {
+	body := bytes.Repeat([]byte{7}, 1000)
+	chunked := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Write(body[:500])
+		w.(http.Flusher).Flush()
+		w.Write(body[500:])
+	}))
+	defer chunked.Close()
+	declared := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Length", "1000")
+		w.Write(body)
+	}))
+	defer declared.Close()
+	cli := &Client{mediaHTTP: http.DefaultClient}
+	for name, server := range map[string]*httptest.Server{"chunked": chunked, "declared": declared} {
+		t.Run(name, func(t *testing.T) {
+			got, err := cli.downloadMedia(WithMediaDownloadLimit(context.Background(), 1000), server.URL)
+			if err != nil || len(got) != 1000 {
+				t.Fatalf("exact limit must pass: %d %v", len(got), err)
+			}
+			if got, err := cli.downloadMedia(WithMediaDownloadLimit(context.Background(), 999), server.URL); !errors.Is(err, ErrMediaDownloadLimit) || got != nil {
+				t.Fatalf("one byte over must fail without data: %d %v", len(got), err)
+			}
+			if got, err := cli.downloadMedia(context.Background(), server.URL); err != nil || len(got) != 1000 {
+				t.Fatalf("unlimited context: %d %v", len(got), err)
+			}
+		})
+	}
+}
+
+type recordingLog struct {
+	mu    sync.Mutex
+	warns []string
+}
+
+func (l *recordingLog) Warnf(msg string, args ...any) {
+	l.mu.Lock()
+	l.warns = append(l.warns, fmt.Sprintf(msg, args...))
+	l.mu.Unlock()
+}
+func (*recordingLog) Errorf(string, ...any)     {}
+func (*recordingLog) Infof(string, ...any)      {}
+func (*recordingLog) Debugf(string, ...any)     {}
+func (l *recordingLog) Sub(string) waLog.Logger { return l }
+func (l *recordingLog) acknowledgements() (n int) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	for _, warn := range l.warns {
+		if strings.Contains(warn, "acknowledgement for protocol message") {
+			n++
+		}
+	}
+	return
+}
+
+// TestManualHistoryFlagsLeaveTheReceiptAndTheDownloadToTheCaller covers IT-HIS-07 at the dependency
+// boundary. Two controls prove the probes see the automatic queueing and the automatic receipt; with
+// both flags the dependency does neither, so any receipt that exists is the caller's.
+func TestManualHistoryFlagsLeaveTheReceiptAndTheDownloadToTheCaller(t *testing.T) {
+	notification := &waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{
+		Type:                    waE2E.ProtocolMessage_HISTORY_SYNC_NOTIFICATION.Enum(),
+		HistorySyncNotification: &waE2E.HistorySyncNotification{DirectPath: proto.String("/v/batch")},
+	}}
+	// run reports whether the handler queued the download (the full queue makes that visible as
+	// a blocked send) and how many receipts it tried to send.
+	run := func(manual, disableReceipt bool) (queued bool, receipts int) {
+		log := &recordingLog{}
+		queue := make(chan *waE2E.HistorySyncNotification, 1)
+		queue <- nil // full: an automatic enqueue cannot complete
+		cli := &Client{Log: log, ManualHistorySyncDownload: manual, DisableManualHistorySyncReceipt: disableReceipt, historySyncNotifications: queue}
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			_, _ = cli.handleProtocolMessage(context.Background(), &types.MessageInfo{MessageSource: types.MessageSource{IsFromMe: true}, ID: "n1"}, notification)
+		}()
+		select {
+		case <-done:
+		case <-time.After(150 * time.Millisecond):
+			queued = true
+			<-queue // release the blocked send so the handler can finish
+			<-done
+		}
+		time.Sleep(100 * time.Millisecond)
+		return queued, log.acknowledgements()
+	}
+	if queued, receipts := run(false, false); !queued || receipts != 1 {
+		t.Fatalf("control: the automatic path queues the download and sends its receipt (%v, %d)", queued, receipts)
+	}
+	if queued, receipts := run(true, false); queued || receipts != 1 {
+		t.Fatalf("control: a manual download alone still sends the receipt (%v, %d)", queued, receipts)
+	}
+	if queued, receipts := run(true, true); queued || receipts != 0 {
+		t.Fatalf("flagged: the dependency neither queues the download nor sends the receipt (%v, %d)", queued, receipts)
+	}
+}
+
+// TestDownloadLimitDoesNotTryTheNextHost: exceeding the byte limit is a verdict on the batch, not on a host,
+// so the other hosts are not asked for up to the limit again.
+func TestDownloadLimitDoesNotTryTheNextHost(t *testing.T) {
+	var hits atomic.Int32
+	handler := http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		hits.Add(1)
+		w.Write(bytes.Repeat([]byte{7}, 1000))
+	})
+	first, second := httptest.NewTLSServer(handler), httptest.NewTLSServer(handler)
+	defer first.Close()
+	defer second.Close()
+	pool := x509.NewCertPool()
+	pool.AddCert(first.Certificate())
+	pool.AddCert(second.Certificate())
+	cli := &Client{Log: waLog.Noop, mediaHTTP: &http.Client{Transport: &http.Transport{TLSClientConfig: &tls.Config{RootCAs: pool}}}}
+	cli.mediaConnCache = &MediaConn{TTL: 3600, FetchedAt: time.Now(), Hosts: []MediaConnHost{
+		{Hostname: strings.TrimPrefix(first.URL, "https://")}, {Hostname: strings.TrimPrefix(second.URL, "https://")}}}
+	_, err := cli.DownloadMediaWithPath(WithMediaDownloadLimit(context.Background(), 999), "/v/t", nil, nil, nil, MediaHistory, "md-msg-hist", true)
+	if !errors.Is(err, ErrMediaDownloadLimit) || hits.Load() != 1 {
+		t.Fatalf("one host is asked once: %v, %d requests", err, hits.Load())
+	}
+}
