+// StageHistorySync applies the protocol effects of a history batch with the stores of ctx.
+// Inside a decryption transaction every write joins it, so the effects publish together with
+// the batch's pending entries or not at all.
+func (cli *Client) StageHistorySync(ctx context.Context, historySync *waHistorySync.HistorySync) error {
+	if err := cli.storeNCTSalt(ctx, historySync.GetNctSalt()); err != nil {
+		return errors.Join(store.ErrLocalStorage, err)
+	}
+	if len(historySync.GetPhoneNumberToLidMappings()) > 0 {
+		if err := cli.storeHistoricalPNLIDMappings(ctx, historySync.GetPhoneNumberToLidMappings()); err != nil {
+			return err
+		}
+	}
+	if historySync.GetSyncType() == waHistorySync.HistorySync_PUSH_NAME {
+		if err := cli.handleHistoricalPushNames(ctx, historySync.GetPushnames()); err != nil {
+			return err
+		}
+	} else if len(historySync.GetConversations()) > 0 {
+		if err := cli.storeHistoricalMessageSecrets(ctx, historySync.GetConversations()); err != nil {
+			return err
+		}
+	}
+	if historySync.GlobalSettings != nil {
+		if err := cli.storeGlobalSettings(ctx, historySync.GlobalSettings); err != nil {
+			return err
+		}
+	}
+	if historySync.CompanionMetaNonce != nil {
+		if err := cli.storeCompanionMetaNonce(ctx, historySync.GetCompanionMetaNonce()); err != nil {
+			return err
+		}
+	}
+	return nil
+}
