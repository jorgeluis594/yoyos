+package whatsmeow
+
+import (
+	"context"
+	"errors"
+)
+
+// ErrMediaDownloadLimit reports a download that exceeded the limit carried by its context.
+var ErrMediaDownloadLimit = errors.New("media download exceeds its byte limit")
+
+type mediaDownloadLimitKey struct{}
+
+// WithMediaDownloadLimit bounds the bytes a download may receive. The limit counts the bytes
+// actually read from the connection, whatever the server or the notification declares.
+func WithMediaDownloadLimit(ctx context.Context, limit int64) context.Context {
+	return context.WithValue(ctx, mediaDownloadLimitKey{}, limit)
+}
+
+func MediaDownloadLimit(ctx context.Context) (int64, bool) {
+	limit, ok := ctx.Value(mediaDownloadLimitKey{}).(int64)
+	return limit, ok
+}
