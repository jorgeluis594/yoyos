+func TestRecoveredProtocolReplayDoesNotDecryptOrDispatch(t *testing.T) {
+	failed := &receiveFailureStore{cause: errors.New("native message secret write failed")}
+	client := NewClient(&store.Device{MsgSecrets: failed}, waLog.Noop)
+	info, _ := recoveryProbeMessage()
+	var dispatched int
+	client.AddEventHandler(func(any) { dispatched++ })
+	plaintext, err := proto.Marshal(&waE2E.Message{Conversation: proto.String("owned content"),
+		MessageContextInfo: &waE2E.MessageContextInfo{MessageSecret: []byte{1}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = client.ReplayRecoveredProtocol(context.Background(), &info, "v2", plaintext)
+	if !errors.Is(err, store.ErrLocalStorage) || dispatched != 0 {
+		t.Fatalf("replay did not stop on durable secret write: %v", err)
+	}
+	v3, err := proto.Marshal(&waMsgTransport.MessageTransport{Protocol: &waMsgTransport.MessageTransport_Protocol{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := client.ReplayRecoveredProtocol(context.Background(), &info, "v3", v3); err != nil || dispatched != 0 {
+		t.Fatalf("v3 replay did not preserve no-dispatch contract: %v", err)
+	}
+}
