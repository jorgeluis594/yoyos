+func TestControlledTransportAttempt(t *testing.T) {
+	_, node := recoveryProbeMessage()
+	client := NewClient(&store.Device{}, nil)
+	called := false
+	client.transportAttempt = func(payload []byte) error {
+		called = true
+		if len(payload) == 0 {
+			t.Fatal("empty ACK frame")
+		}
+		return nil
+	}
+	client.sendAck(context.Background(), &node, 0)
+	if !called {
+		t.Fatal("ACK did not reach controlled transport")
+	}
+}
