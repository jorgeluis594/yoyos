+}
+
+// ReplayRecoveredProtocol completes post-decryption writes without decrypting a
+// second time or dispatching the already durable application message.
+func (cli *Client) ReplayRecoveredProtocol(ctx context.Context, info *types.MessageInfo, format string, plaintext []byte) error {
+	if info == nil || len(plaintext) == 0 {
+		return errors.New("missing recovered message")
+	}
+	switch format {
+	case "v2":
+		var msg waE2E.Message
+		if err := proto.Unmarshal(plaintext, &msg); err != nil {
+			return err
+		}
+		_, err := cli.processProtocolParts(ctx, info, &msg)
+		return err
+	case "v3":
+		decoded, err := decodeArmadillo(plaintext)
+		if err != nil {
+			return err
+		}
+		if info.IsGroup && decoded.Transport.GetProtocol().GetAncillary().GetSkdm() != nil {
+			return cli.handleSenderKeyDistributionMessage(ctx, info.Chat, info.Sender, decoded.Transport.GetProtocol().GetAncillary().GetSkdm().AxolotlSenderKeyDistributionMessage)
+		}
+		return nil
+	default:
+		return errors.New("unknown recovered message format")
+	}
 }
 
