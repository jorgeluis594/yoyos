+
+// ReplayRecoveredProtocol completes post-decryption writes without decrypting a
+// second time or dispatching the already durable application message.
+func (cli *Client) ReplayRecoveredProtocol(ctx context.Context, info *types.MessageInfo, format string, plaintext []byte) error {
+	if info == nil || len(plaintext) == 0 {
+		return errors.New("missing recovered message")
+	}
+	switch format {
+	case "v2":
+		var msg waE2E.Message
+		if err := proto.Unmarshal(plaintext, &msg); err != nil {
+			return err
+		}
+		if err := cli.storeMessageSecret(ctx, info, &msg); err != nil {
+			return err
+		}
+		inner := &msg
+		if nested := msg.GetDeviceSentMessage().GetMessage(); nested != nil {
+			inner = nested
+		}
+		if skdm := inner.GetSenderKeyDistributionMessage(); skdm != nil && info.IsGroup {
+			from := info.Sender
+			if from.Server == types.DefaultUserServer && info.SenderAlt.Server == types.HiddenUserServer {
+				from = info.SenderAlt
+			}
+			if err := cli.handleSenderKeyDistributionMessage(ctx, info.Chat, from, skdm.AxolotlSenderKeyDistributionMessage); err != nil {
+				return err
+			}
+		}
+		if info.IsFromMe && inner.GetProtocolMessage() != nil {
+			protocol := inner.GetProtocolMessage()
+			if mapping := protocol.GetLidMigrationMappingSyncMessage(); mapping != nil {
+				if err := cli.storeLIDSyncMessage(ctx, mapping.GetEncodedMappingPayload()); err != nil {
+					return err
+				}
+			}
+			if keys := protocol.GetAppStateSyncKeyShare(); keys != nil {
+				if _, err := cli.storeAppStateSyncKeys(ctx, keys); err != nil {
+					return err
+				}
+			}
+		}
+		return nil
+	case "v3":
+		decoded, err := decodeArmadillo(plaintext)
+		if err != nil {
+			return err
+		}
+		if info.IsGroup && decoded.Transport.GetProtocol().GetAncillary().GetSkdm() != nil {
+			return cli.handleSenderKeyDistributionMessage(ctx, info.Chat, info.Sender, decoded.Transport.GetProtocol().GetAncillary().GetSkdm().AxolotlSenderKeyDistributionMessage)
+		}
+		return nil
+	default:
+		return errors.New("unknown recovered message format")
+	}
 }
 
