diff --git a/appstate/wa03_atomic_test.go b/appstate/wa03_atomic_test.go
new file mode 100644
index 0000000..acc508c
--- /dev/null
+++ b/appstate/wa03_atomic_test.go
@@ -0,0 +1,64 @@
+package appstate
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"go.mau.fi/whatsmeow/store"
+)
+
+type wa03TxnKey struct{}
+type wa03TxnBuffer struct {
+	store.EventBuffer
+	calls, commits int
+}
+
+func (b *wa03TxnBuffer) DoDecryptionTxn(ctx context.Context, fn func(context.Context) error) error {
+	b.calls++
+	err := fn(context.WithValue(ctx, wa03TxnKey{}, true))
+	if err == nil {
+		b.commits++
+	}
+	return err
+}
+
+type wa03MACStore struct {
+	store.AppStateStore
+	steps []string
+	fail  bool
+}
+
+func (s *wa03MACStore) record(ctx context.Context, step string) error {
+	if ctx.Value(wa03TxnKey{}) != true {
+		return errors.New("write escaped transaction")
+	}
+	s.steps = append(s.steps, step)
+	if s.fail && step == "add" {
+		return store.ErrLocalStorage
+	}
+	return nil
+}
+func (s *wa03MACStore) PutAppStateVersion(ctx context.Context, _ string, _ uint64, _ [128]byte) error {
+	return s.record(ctx, "version")
+}
+func (s *wa03MACStore) DeleteAppStateMutationMACs(ctx context.Context, _ string, _ [][]byte) error {
+	return s.record(ctx, "remove")
+}
+func (s *wa03MACStore) PutAppStateMutationMACs(ctx context.Context, _ string, _ uint64, _ []store.AppStateMutationMAC) error {
+	return s.record(ctx, "add")
+}
+
+func TestWA03AppStateMACPublicationUsesOneTransaction(t *testing.T) {
+	buffer := &wa03TxnBuffer{}
+	macs := &wa03MACStore{fail: true}
+	processor := &Processor{Store: &store.Device{EventBuffer: buffer, AppState: macs}}
+	err := processor.storeMACs(context.Background(), "regular", HashState{Version: 2}, &patchOutput{})
+	if !errors.Is(err, store.ErrLocalStorage) || buffer.calls != 1 || buffer.commits != 0 || len(macs.steps) != 3 {
+		t.Fatal("partial app-state publication", err, buffer, macs.steps)
+	}
+	macs.fail = false
+	if err := processor.storeMACs(context.Background(), "regular", HashState{Version: 2}, &patchOutput{}); err != nil || buffer.calls != 2 || buffer.commits != 1 {
+		t.Fatal("app-state update did not commit as one unit", err)
+	}
+}
