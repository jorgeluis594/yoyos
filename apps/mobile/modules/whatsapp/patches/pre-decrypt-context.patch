+func TestQRDeadlineIsFixedBeforeBufferedConsumption(t *testing.T) {
+	items := make(chan QRChannelItem, 1)
+	stop := make(chan struct{})
+	done := make(chan struct{})
+	client := NewClient(&store.Device{}, waLog.Noop)
+	channel := &qrChannel{cli: client, log: waLog.Noop, ctx: context.Background(), output: items, stopQRs: stop, rotateAdv: make(chan *events.RotateADVSecret)}
+	go func() { defer close(done); channel.emitQRs([]string{"owned-code"}) }()
+	time.Sleep(30 * time.Millisecond)
+	item := <-items
+	close(stop)
+	<-done
+	if item.Event != QRChannelEventCode || item.Code != "owned-code" || item.ExpiresAt.IsZero() || time.Until(item.ExpiresAt) >= item.Timeout-15*time.Millisecond {
+		t.Fatal("QR deadline was reconstructed after buffered consumption")
+	}
+}
