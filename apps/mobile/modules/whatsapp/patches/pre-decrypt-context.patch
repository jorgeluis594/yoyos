+func TestAuxiliarySyncStorageFailuresPropagate(t *testing.T) {
+	failed := &store.NoopStore{Error: errors.New("native writer failed")}
+	client := NewClient(&store.Device{AppStateKeys: failed, NCTSalt: failed}, waLog.Noop)
+	keys := &waE2E.AppStateSyncKeyShare{Keys: []*waE2E.AppStateSyncKey{{
+		KeyID:   &waE2E.AppStateSyncKeyId{KeyID: []byte{1}},
+		KeyData: &waE2E.AppStateSyncKeyData{Fingerprint: &waE2E.AppStateSyncKeyFingerprint{}},
+	}}}
+	if err := client.handleAppStateSyncKeyShare(context.Background(), keys); !errors.Is(err, store.ErrLocalStorage) {
+		t.Fatalf("app state write failure was not local: %v", err)
+	}
+	raw, err := proto.Marshal(&waHistorySync.HistorySync{SyncType: waHistorySync.HistorySync_INITIAL_BOOTSTRAP.Enum(), NctSalt: []byte{1}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var compressed bytes.Buffer
+	writer := zlib.NewWriter(&compressed)
+	if _, err = writer.Write(raw); err != nil {
+		t.Fatal(err)
+	}
+	if err = writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	notif := &waE2E.HistorySyncNotification{InitialHistBootstrapInlinePayload: compressed.Bytes()}
+	result, err := client.DownloadHistorySync(context.Background(), notif, true)
+	if result != nil || !errors.Is(err, store.ErrLocalStorage) {
+		t.Fatalf("history auxiliary failure was not propagated: %v", err)
+	}
+}
